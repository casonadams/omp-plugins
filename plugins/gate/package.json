{
  "name": "gate",
  "version": "0.2.0",
  "description": "Completion gate for omp: blocks git commit until ripwire-rs verification passes, and asks for a Gate summary before a turn ends",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "crap": "bun scripts/check-crap.ts",
    "lint": "oxlint -D complexity",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run crap"
  },
  "omp": {
    "extensions": [
      "index.ts"
    ]
  },
  "keywords": [
    "omp-plugin",
    "oh-my-pi",
    "ripwire",
    "verification",
    "git",
    "quality"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
